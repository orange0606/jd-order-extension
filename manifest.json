{
  "manifest_version": 3,
  "name": "京东订单数据抓取助手",
  "version": "3.0.1",
  "description": "自动检测京东商家后台订单页面，抓取订单数据并同步到智查查风控系统",
  "permissions": [
    "storage",
    "activeTab",
    "scripting",
    "cookies",
    "tabs",
    "clipboardRead",
    "webNavigation",
    "debugger",
    "declarativeNetRequest"
  ],
  "host_permissions": [
    "https://shop.jd.com/*",
    "https://*.jd.com/*",
    "https://pay.jingbashi.com/*",
    "https://zzc.jingbashi.com/*",
    "http://localhost:3000/*",
    "http://127.0.0.1:3000/*",
    "http://81.71.9.134/*",
    "https://mobile.yangkeduo.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "http://localhost/*",
        "http://127.0.0.1/*",
        "http://81.71.9.134/zhichacha/*"
      ],
      "js": [
        "content/ledger-bridge.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://shop.jd.com/jdm/trade/*"
      ],
      "js": [
        "content/ledger-panel.js"
      ],
      "css": [
        "content/ledger-panel.css"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://shop.jd.com/jdm/trade/orders/order-list*",
        "https://shop.jd.com/jdm/trade/orders/*"
      ],
      "js": [
        "config.js",
        "content/content.js",
        "content/desktop-pet.js"
      ],
      "css": [
        "content/content.css",
        "content/desktop-pet.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://jzt.jd.com/home/*"
      ],
      "js": [
        "content/ad-cost-collector.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://pay.jingbashi.com/*"
      ],
      "js": [
        "config.js",
        "content/content.js"
      ],
      "css": [
        "content/content.css"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://shop.jd.com/jdm/trade/after-sale/independent-after-sale/list*"
      ],
      "js": [
        "content/after-sale-bind.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://shop.jd.com/jdm/trade/orders/order-list*"
      ],
      "js": [
        "content/order-pdd-win.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    },
    {
      "matches": [
        "https://mobile.yangkeduo.com/*"
      ],
      "js": [
        "content/block-dialog-hook.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true,
      "world": "MAIN"
    },
    {
      "matches": [
        "https://mobile.yangkeduo.com/*"
      ],
      "js": [
        "content/block-dialog-inject.js"
      ],
      "run_at": "document_start",
      "all_frames": true,
      "match_origin_as_fallback": true
    },
    {
      "matches": [
        "https://mobile.yangkeduo.com/*"
      ],
      "js": [
        "content/pdd-embed.js"
      ],
      "run_at": "document_start",
      "all_frames": true
    },
    {
      "matches": [
        "https://zzc.jingbashi.com/returns*"
      ],
      "js": [
        "content/returns-quick-fill.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    },
    {
      "matches": [
        "https://zzc.jingbashi.com/*"
      ],
      "js": [
        "content/zzc-proxy.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    },
    "default_title": "京东订单抓取助手"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "icons/*",
        "content/*"
      ],
      "matches": [
        "https://shop.jd.com/*"
      ]
    },
    {
      "resources": [
        "content/block-dialog-hook.js"
      ],
      "matches": [
        "https://mobile.yangkeduo.com/*"
      ]
    }
  ]
}
